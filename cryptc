#!/usr/bin/env python3
"""cryptc - single-file encrypted container you mount yourself, no root needed.

A "container.file" is a SQLCipher-encrypted SQLite database. Files and
directories live as rows inside it; file content is stored in fixed-size
chunks. Mounting is done via FUSE, entirely in user space, so any user who
knows the password can mount/unmount their own container without sudo.

Design choices (see README.md for the full rationale):
  * Growth is automatic: SQLite simply grows the backing file as rows are
    inserted. No resize step, ever.
  * Crash safety comes from SQLite's WAL journal (this is one of the most
    heavily crash-tested file formats that exists) plus a built-in
    SQLCipher per-page HMAC integrity check ("cryptc check").
  * Encryption is SQLCipher's default (AES-256-CBC per page + HMAC-SHA512,
    key derived from the password via PBKDF2). Good enough without being
    the focus of the project.
"""
import argparse
import errno
import getpass
import os
import re
import stat
import sys
import time

BLOCK_SIZE = 128 * 1024
SCHEMA_VERSION = 1
ROOT_INO = 1

SCHEMA = """
CREATE TABLE meta (
    key   TEXT PRIMARY KEY,
    value TEXT
);
CREATE TABLE inodes (
    ino            INTEGER PRIMARY KEY,
    parent         INTEGER NOT NULL,
    name           TEXT NOT NULL,
    kind           INTEGER NOT NULL,   -- 0=dir 1=file 2=symlink
    mode           INTEGER NOT NULL,
    uid            INTEGER NOT NULL,
    gid            INTEGER NOT NULL,
    size           INTEGER NOT NULL DEFAULT 0,
    atime          REAL NOT NULL,
    mtime          REAL NOT NULL,
    ctime          REAL NOT NULL,
    symlink_target TEXT,
    UNIQUE(parent, name)
);
CREATE INDEX idx_inodes_parent ON inodes(parent);
CREATE TABLE data (
    ino      INTEGER NOT NULL,
    block_no INTEGER NOT NULL,
    content  BLOB NOT NULL,
    PRIMARY KEY (ino, block_no)
) WITHOUT ROWID;
"""

KIND_DIR, KIND_FILE, KIND_SYMLINK = 0, 1, 2


def die(msg, code=1):
    print(f"cryptc: {msg}", file=sys.stderr)
    sys.exit(code)


def pragma_key_sql(pragma, value):
    # PRAGMA statements don't support bound (?) parameters in SQLite, so the
    # password has to be embedded as a quoted string literal. Escape any
    # embedded single quotes the standard SQL way (' -> '').
    escaped = value.replace("'", "''")
    return f"PRAGMA {pragma} = '{escaped}'"


def import_backend():
    try:
        import sqlcipher3 as backend
    except ImportError:
        die(
            "the 'sqlcipher3-binary' package is not installed.\n"
            "  Set up the environment first, e.g.:\n"
            "    python3 -m venv .venv && . .venv/bin/activate\n"
            "    pip install -r requirements.txt"
        )
    return backend


def read_password(confirm=False):
    pw = getpass.getpass("Container password: ")
    if not pw:
        die("empty password refused")
    if confirm:
        pw2 = getpass.getpass("Confirm password: ")
        if pw != pw2:
            die("passwords did not match")
    return pw


def open_db(backend, path, password, readonly=False):
    if not os.path.isfile(path):
        die(f"{path} not found")
    uri = f"file:{os.path.abspath(path)}{'?mode=ro' if readonly else ''}"
    con = backend.connect(uri, uri=True, check_same_thread=False)
    con.execute(pragma_key_sql("key", password))
    try:
        con.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
    except backend.DatabaseError:
        con.close()
        die("wrong password, or the file is not a cryptc container")
    if not readonly:
        con.execute("PRAGMA journal_mode = WAL")
        con.execute("PRAGMA synchronous = NORMAL")
        con.execute("PRAGMA foreign_keys = OFF")
    return con


# --------------------------------------------------------------------------
# create
# --------------------------------------------------------------------------

def cmd_create(args):
    backend = import_backend()
    if os.path.exists(args.file):
        die(f"{args.file} already exists")
    directory = os.path.dirname(os.path.abspath(args.file))
    os.makedirs(directory, exist_ok=True)

    password = read_password(confirm=True)

    con = backend.connect(args.file)
    con.execute(pragma_key_sql("key", password))
    con.execute("PRAGMA cipher_page_size = 4096")
    con.executescript(SCHEMA)
    now = time.time()
    con.execute(
        "INSERT INTO inodes (ino, parent, name, kind, mode, uid, gid, size, atime, mtime, ctime) "
        "VALUES (?, 0, '', ?, ?, ?, ?, 0, ?, ?, ?)",
        (ROOT_INO, KIND_DIR, stat.S_IFDIR | 0o700, os.getuid(), os.getgid(), now, now, now),
    )
    meta = {
        "schema_version": str(SCHEMA_VERSION),
        "created_at": str(now),
        "block_size": str(BLOCK_SIZE),
        "max_size": str(args.max_size or 0),
    }
    con.executemany("INSERT INTO meta (key, value) VALUES (?, ?)", meta.items())
    con.commit()
    con.execute("PRAGMA journal_mode = WAL")
    con.commit()
    con.close()
    os.chmod(args.file, 0o600)

    print(f"cryptc: created {args.file}"
          + (f" (grows automatically up to {args.max_size} bytes)" if args.max_size else " (grows automatically, no ceiling)"))


# --------------------------------------------------------------------------
# FUSE filesystem
# --------------------------------------------------------------------------

def build_operations_class():
    from fuse import FUSE, FuseOSError, Operations  # imported lazily: only needed for mount

    class CryptcFS(Operations):
        use_ns = True

        def __init__(self, con, backend, max_size):
            self.con = con
            self.backend = backend
            self.max_size = max_size
            self.uid = os.getuid()
            self.gid = os.getgid()

        # -- helpers ----------------------------------------------------

        def _row(self, ino):
            r = self.con.execute(
                "SELECT ino, parent, name, kind, mode, uid, gid, size, atime, mtime, ctime, symlink_target "
                "FROM inodes WHERE ino=?", (ino,)
            ).fetchone()
            if r is None:
                raise FuseOSError(errno.ENOENT)
            return r

        def _lookup(self, path):
            if path == "/":
                return ROOT_INO
            ino = ROOT_INO
            for part in path.strip("/").split("/"):
                r = self.con.execute(
                    "SELECT ino FROM inodes WHERE parent=? AND name=?", (ino, part)
                ).fetchone()
                if r is None:
                    raise FuseOSError(errno.ENOENT)
                ino = r[0]
            return ino

        def _child(self, parent_ino, name):
            r = self.con.execute(
                "SELECT ino FROM inodes WHERE parent=? AND name=?", (parent_ino, name)
            ).fetchone()
            return r[0] if r else None

        def _has_children(self, ino):
            return self.con.execute(
                "SELECT 1 FROM inodes WHERE parent=? LIMIT 1", (ino,)
            ).fetchone() is not None

        def _get_block(self, ino, block_no):
            r = self.con.execute(
                "SELECT content FROM data WHERE ino=? AND block_no=?", (ino, block_no)
            ).fetchone()
            return r[0] if r else b""

        def _put_block(self, ino, block_no, content):
            if content:
                self.con.execute(
                    "INSERT INTO data (ino, block_no, content) VALUES (?, ?, ?) "
                    "ON CONFLICT(ino, block_no) DO UPDATE SET content=excluded.content",
                    (ino, block_no, content),
                )
            else:
                self.con.execute("DELETE FROM data WHERE ino=? AND block_no=?", (ino, block_no))

        def _current_total_size(self):
            r = self.con.execute("SELECT COALESCE(SUM(size), 0) FROM inodes").fetchone()
            return r[0]

        def _check_quota(self, extra_needed):
            if not self.max_size:
                return
            if self._current_total_size() + extra_needed > self.max_size:
                raise FuseOSError(errno.ENOSPC)

        def _touch(self, ino, mtime=True, ctime=True):
            now = time.time()
            if mtime and ctime:
                self.con.execute("UPDATE inodes SET mtime=?, ctime=? WHERE ino=?", (now, now, ino))
            elif ctime:
                self.con.execute("UPDATE inodes SET ctime=? WHERE ino=?", (now, ino))

        def _attr_dict(self, row):
            (ino, parent, name, kind, mode, uid, gid, size, atime, mtime, ctime, symlink_target) = row
            nlink = 2 if kind == KIND_DIR else 1
            return {
                "st_ino": ino,
                "st_mode": mode,
                "st_nlink": nlink,
                "st_uid": uid,
                "st_gid": gid,
                "st_size": size,
                "st_atime": int(atime * 1e9),
                "st_mtime": int(mtime * 1e9),
                "st_ctime": int(ctime * 1e9),
            }

        # -- filesystem metadata -----------------------------------------

        def statfs(self, path):
            st = os.statvfs(os.path.dirname(os.path.abspath(self.con.execute("PRAGMA database_list").fetchone()[2])) or "/")
            used = self._current_total_size()
            if self.max_size:
                total_blocks = self.max_size // 4096
                free_blocks = max(0, (self.max_size - used) // 4096)
            else:
                total_blocks = st.f_blocks
                free_blocks = st.f_bavail
            return {
                "f_bsize": 4096, "f_frsize": 4096,
                "f_blocks": total_blocks, "f_bfree": free_blocks, "f_bavail": free_blocks,
                "f_files": 0, "f_ffree": 1000000, "f_namemax": 255,
            }

        def access(self, path, mode):
            return 0  # single-user container: whoever mounted it gets full access

        # -- attributes / directories -------------------------------------

        def getattr(self, path, fh=None):
            return self._attr_dict(self._row(self._lookup(path)))

        def readdir(self, path, fh):
            ino = self._lookup(path)
            yield "."
            yield ".."
            for (name,) in self.con.execute("SELECT name FROM inodes WHERE parent=?", (ino,)):
                yield name

        def mkdir(self, path, mode):
            parent = self._lookup(os.path.dirname(path))
            name = os.path.basename(path)
            if self._child(parent, name) is not None:
                raise FuseOSError(errno.EEXIST)
            now = time.time()
            self.con.execute(
                "INSERT INTO inodes (parent, name, kind, mode, uid, gid, size, atime, mtime, ctime) "
                "VALUES (?, ?, ?, ?, ?, ?, 0, ?, ?, ?)",
                (parent, name, KIND_DIR, stat.S_IFDIR | (mode & 0o7777), self.uid, self.gid, now, now, now),
            )
            self._touch(parent)
            self.con.commit()

        def rmdir(self, path):
            ino = self._lookup(path)
            if ino == ROOT_INO:
                raise FuseOSError(errno.EBUSY)
            row = self._row(ino)
            if row[3] != KIND_DIR:
                raise FuseOSError(errno.ENOTDIR)
            if self._has_children(ino):
                raise FuseOSError(errno.ENOTEMPTY)
            self.con.execute("DELETE FROM inodes WHERE ino=?", (ino,))
            self._touch(row[1])
            self.con.commit()

        # -- files -----------------------------------------------------

        def create(self, path, mode, fi=None):
            parent = self._lookup(os.path.dirname(path))
            name = os.path.basename(path)
            if self._child(parent, name) is not None:
                raise FuseOSError(errno.EEXIST)
            self._check_quota(0)
            now = time.time()
            cur = self.con.execute(
                "INSERT INTO inodes (parent, name, kind, mode, uid, gid, size, atime, mtime, ctime) "
                "VALUES (?, ?, ?, ?, ?, ?, 0, ?, ?, ?)",
                (parent, name, KIND_FILE, stat.S_IFREG | (mode & 0o7777), self.uid, self.gid, now, now, now),
            )
            self._touch(parent)
            self.con.commit()
            return cur.lastrowid

        def open(self, path, flags):
            return self._lookup(path)

        def unlink(self, path):
            parent = self._lookup(os.path.dirname(path))
            ino = self._lookup(path)
            self.con.execute("DELETE FROM data WHERE ino=?", (ino,))
            self.con.execute("DELETE FROM inodes WHERE ino=?", (ino,))
            self._touch(parent)
            self.con.commit()

        def read(self, path, size, offset, fh):
            ino = fh
            file_size = self._row(ino)[7]
            end = min(offset + size, file_size)
            if end <= offset:
                return b""
            out = bytearray()
            pos = offset
            while pos < end:
                block_no, block_off = divmod(pos, BLOCK_SIZE)
                chunk_len = min(BLOCK_SIZE - block_off, end - pos)
                block = self._get_block(ino, block_no)
                piece = block[block_off:block_off + chunk_len] if block_off < len(block) else b""
                if len(piece) < chunk_len:
                    piece = piece + b"\x00" * (chunk_len - len(piece))
                out.extend(piece)
                pos += chunk_len
            return bytes(out)

        def write(self, path, data, offset, fh):
            ino = fh
            old_size = self._row(ino)[7]
            self._check_quota(max(0, offset + len(data) - old_size))
            pos = offset
            remaining = data
            while remaining:
                block_no, block_off = divmod(pos, BLOCK_SIZE)
                chunk = remaining[:BLOCK_SIZE - block_off]
                existing = self._get_block(ino, block_no)
                buf = bytearray(existing)
                need_len = block_off + len(chunk)
                if len(buf) < need_len:
                    buf.extend(b"\x00" * (need_len - len(buf)))
                buf[block_off:block_off + len(chunk)] = chunk
                self._put_block(ino, block_no, bytes(buf))
                pos += len(chunk)
                remaining = remaining[len(chunk):]
            new_size = max(old_size, offset + len(data))
            self.con.execute("UPDATE inodes SET size=?, mtime=?, ctime=? WHERE ino=?",
                              (new_size, time.time(), time.time(), ino))
            self.con.commit()
            return len(data)

        def truncate(self, path, length, fh=None):
            ino = fh if fh is not None else self._lookup(path)
            last_block, last_off = divmod(length, BLOCK_SIZE)
            self.con.execute("DELETE FROM data WHERE ino=? AND block_no>?", (ino, last_block))
            if last_off > 0:
                block = self._get_block(ino, last_block)[:last_off]
                self._put_block(ino, last_block, block)
            else:
                self.con.execute("DELETE FROM data WHERE ino=? AND block_no=?", (ino, last_block))
            self.con.execute("UPDATE inodes SET size=?, mtime=?, ctime=? WHERE ino=?",
                              (length, time.time(), time.time(), ino))
            self.con.commit()

        def flush(self, path, fh):
            self.con.commit()

        def fsync(self, path, fdatasync, fh):
            self.con.commit()

        def release(self, path, fh):
            self.con.commit()
            return 0

        # -- links / rename / misc --------------------------------------

        def symlink(self, path, target):
            parent = self._lookup(os.path.dirname(path))
            name = os.path.basename(path)
            if self._child(parent, name) is not None:
                raise FuseOSError(errno.EEXIST)
            now = time.time()
            self.con.execute(
                "INSERT INTO inodes (parent, name, kind, mode, uid, gid, size, atime, mtime, ctime, symlink_target) "
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                (parent, name, KIND_SYMLINK, stat.S_IFLNK | 0o777, self.uid, self.gid,
                 len(target), now, now, now, target),
            )
            self._touch(parent)
            self.con.commit()

        def readlink(self, path):
            row = self._row(self._lookup(path))
            return row[11] or ""

        def rename(self, old, new):
            ino = self._lookup(old)
            new_parent = self._lookup(os.path.dirname(new))
            new_name = os.path.basename(new)
            existing = self._child(new_parent, new_name)
            if existing is not None:
                self.con.execute("DELETE FROM data WHERE ino=?", (existing,))
                self.con.execute("DELETE FROM inodes WHERE ino=?", (existing,))
            self.con.execute("UPDATE inodes SET parent=?, name=? WHERE ino=?", (new_parent, new_name, ino))
            self.con.commit()

        def chmod(self, path, mode):
            ino = self._lookup(path)
            row = self._row(ino)
            kind_bits = row[4] & ~0o7777
            self.con.execute("UPDATE inodes SET mode=?, ctime=? WHERE ino=?",
                              (kind_bits | (mode & 0o7777), time.time(), ino))
            self.con.commit()

        def chown(self, path, uid, gid):
            ino = self._lookup(path)
            if uid == -1 or uid is None:
                uid = self._row(ino)[5]
            if gid == -1 or gid is None:
                gid = self._row(ino)[6]
            self.con.execute("UPDATE inodes SET uid=?, gid=?, ctime=? WHERE ino=?",
                              (uid, gid, time.time(), ino))
            self.con.commit()

        def utimens(self, path, times=None):
            ino = self._lookup(path)
            now = time.time()
            atime, mtime = times if times else (now, now)
            self.con.execute("UPDATE inodes SET atime=?, mtime=? WHERE ino=?", (atime, mtime, ino))
            self.con.commit()

    return CryptcFS, FUSE, FuseOSError


# --------------------------------------------------------------------------
# mount / umount
# --------------------------------------------------------------------------

def cmd_mount(args):
    backend = import_backend()
    CryptcFS, FUSE, _ = build_operations_class()

    password = read_password()
    con = open_db(backend, args.file, password)
    max_size = int(con.execute("SELECT value FROM meta WHERE key='max_size'").fetchone()[0] or 0)

    os.makedirs(args.mountpoint, exist_ok=True)
    if os.listdir(args.mountpoint):
        die(f"mountpoint {args.mountpoint} is not empty")

    fs = CryptcFS(con, backend, max_size)
    print(f"cryptc: mounting {args.file} at {args.mountpoint}")
    # Without big_writes/max_write, FUSE2 caps each write() request at 4KiB,
    # so a single ~126KB file write arrives as ~31 separate FUSE calls - and
    # since every write() commits its own transaction, that's ~31 commits
    # instead of 1. Raising the negotiated write size to the block size fixes
    # that at the source.
    FUSE(
        fs,
        args.mountpoint,
        foreground=args.foreground,
        nothreads=True,
        big_writes=True,
        max_write=BLOCK_SIZE,
        max_read=BLOCK_SIZE,
    )


def cmd_umount(args):
    import subprocess
    for candidate in ("fusermount3", "fusermount"):
        exe = shutil_which(candidate)
        if exe:
            rc = subprocess.call([exe, "-u", args.mountpoint])
            sys.exit(rc)
    # fallback for macOS
    rc = subprocess.call(["umount", args.mountpoint])
    sys.exit(rc)


def shutil_which(name):
    import shutil
    return shutil.which(name)


